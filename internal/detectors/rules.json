    {
      "id": "akamai.app_and_api_protector",
      "name": "Akamai App & API Protector",
      "description": "Detects Akamai App & API Protector or Kona Site Defender WAF reference error block pages and mitigation headers.",
      "category": "waf",
      "vendor": "Akamai",
      "product": "App & API Protector",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "requires": [
        "akamai.edge"
      ],
      "match": {
        "any": [
          {
            "signal": {
              "id": "akamai-waf-session-header",
              "group": "response_headers",
              "description": "Akamai WAF session info response header",
              "type": "response_header",
              "key": {
                "exact": "x-akamai-session-info",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "akamai-waf-block-page",
              "group": "static_integration",
              "description": "Akamai WAF reference error block page content",
              "type": "page_content",
              "value": {
                "regex": "(?s)(?:Access Denied.*You don't have permission to access.*Reference&#32;&#35;|<title>Access Denied</title>.*Reference&#32;&#35;[0-9a-fA-F.]+)",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "akamai-waf-action-header",
              "group": "response_headers",
              "description": "Akamai WAF action response header",
              "type": "response_header",
              "key": {
                "exact": "x-akamai-waf-action",
                "case_insensitive": true
              },
              "weight": 35
            }
          },
          {
            "signal": {
              "id": "akamai-waf-marker",
