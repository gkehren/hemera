{
  "schema_version": 2,
  "rules": [
    {
      "id": "cloudflare.proxy",
      "name": "Cloudflare Reverse Proxy",
      "description": "Detects Cloudflare edge reverse proxy from Server headers, CF-Ray tracking headers, CNAME routing, or edge cookies.",
      "category": "cdn_reverse_proxy",
      "vendor": "Cloudflare",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "match": {
        "any": [
          {
            "signal": {
              "id": "cloudflare-server-header",
              "group": "response_headers",
              "description": "Cloudflare Server response header",
              "type": "response_header",
              "key": {
                "exact": "Server",
                "case_insensitive": true
              },
              "value": {
                "contains": "cloudflare",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-ray-header",
              "group": "response_headers",
              "description": "Cloudflare CF-Ray tracking header",
              "type": "response_header",
              "key": {
                "exact": "cf-ray",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-cache-header",
              "group": "response_headers",
              "description": "Cloudflare CF-Cache-Status header",
              "type": "response_header",
              "key": {
                "exact": "cf-cache-status",
                "case_insensitive": true
              },
              "weight": 35
            }
          },
          {
            "signal": {
              "id": "cloudflare-cname",
              "group": "dns",
              "description": "Cloudflare canonical edge CNAME",
              "type": "dns_record",
              "key": {
                "exact": "cname",
                "case_insensitive": true
              },
              "value": {
                "regex": "\\.(?:cdn\\.)?cloudflare\\.net$",
                "case_insensitive": true
              },
              "weight": 30
            }
          },
          {
            "signal": {
              "id": "cloudflare-cert-issuer",
              "group": "tls",
              "description": "Cloudflare issued TLS certificate",
              "type": "tls_property",
              "key": {
                "exact": "certificate_issuer",
                "case_insensitive": true
              },
              "value": {
                "contains": "Cloudflare",
                "case_insensitive": true
              },
              "weight": 20
            }
          },
          {
            "signal": {
              "id": "cloudflare-clearance-cookie",
              "group": "cookies",
              "description": "Cloudflare clearance cookie",
              "type": "cookie",
              "key": {
                "exact": "cf_clearance",
                "case_insensitive": true
              },
              "weight": 25
            }
          }
        ]
      }
    },
    {
      "id": "cloudflare.waf",
      "name": "Cloudflare WAF",
      "description": "Detects Cloudflare WAF block pages, challenge pages, or security error headers.",
      "category": "waf",
      "vendor": "Cloudflare",
      "product": "WAF",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "match": {
        "any": [
          {
            "signal": {
              "id": "cloudflare-waf-mitigated-header",
              "group": "response_headers",
              "description": "Cloudflare challenge mitigation header",
              "type": "response_header",
              "key": {
                "exact": "cf-mitigated",
                "case_insensitive": true
              },
              "value": {
                "exact": "challenge",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-waf-error-header",
              "group": "response_headers",
              "description": "Cloudflare security error code header",
              "type": "response_header",
              "key": {
                "exact": "cf-error-code",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-waf-block-page",
              "group": "static_integration",
              "description": "Cloudflare WAF error or challenge block page marker",
              "type": "page_content",
              "value": {
                "regex": "(?:Attention Required! \\| Cloudflare|Cloudflare Ray ID:.*Cloudflare|Sorry, you have been blocked)",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-waf-challenge-script",
              "group": "static_integration",
              "description": "Cloudflare managed challenge platform script",
              "type": "script_url",
              "value": {
                "regex": "/cdn-cgi/challenge-platform/h/[a-z]/orchestrate/chl_page/v1",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-waf-marker",
              "group": "static_integration",
              "description": "Cloudflare error wrapper or details marker",
              "type": "page_content",
              "value": {
                "regex": "(?:cf-error-details|cf-wrapper)",
                "case_insensitive": true
              },
              "weight": 35
            }
          }
        ]
      }
    },
    {
      "id": "cloudflare.bot_management",
      "name": "Cloudflare Bot Management",
      "description": "Detects Cloudflare Bot Management or Bot Fight Mode client-side telemetry scripts and tracking cookies.",
      "category": "bot_management",
      "vendor": "Cloudflare",
      "product": "Bot Management",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "requires": [
        "cloudflare.proxy"
      ],
      "match": {
        "any": [
          {
            "signal": {
              "id": "cloudflare-bot-telemetry-script",
              "group": "static_integration",
              "description": "Cloudflare Bot Management JavaScript detection telemetry script",
              "type": "script_url",
              "value": {
                "regex": "^https?://[^/]+/cdn-cgi/challenge-platform/(?:scripts/jsd/main\\.js|h/[a-z]/scripts/|invisible\\.js)",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "cloudflare-bot-cookie",
              "group": "cookies",
              "description": "Cloudflare Bot Management cookie",
              "type": "cookie",
              "key": {
                "exact": "__cf_bm",
                "case_insensitive": true
              },
              "weight": 40
            }
          }
        ]
      }
    },
    {
      "id": "cloudflare.turnstile",
      "name": "Cloudflare Turnstile",
      "description": "Detects the documented Turnstile client script; static HTML markers are supporting evidence only.",
      "category": "captcha_challenge",
      "vendor": "Cloudflare",
      "product": "Turnstile",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "match": {
        "any": [
          {
            "signal": {
              "id": "turnstile-client-script",
              "group": "static_integration",
              "description": "Documented Turnstile JavaScript API URL",
              "type": "script_url",
              "source": {
                "exact": "http_analyzer"
              },
              "value": {
                "regex": "^https://challenges\\.cloudflare\\.com/turnstile/v0/api\\.js(?:\\?redacted)?$",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "turnstile-html-marker",
              "group": "static_integration",
              "description": "Static cf-turnstile widget marker",
              "type": "page_content",
              "source": {
                "exact": "http_analyzer"
              },
              "value": {
                "regex": "(?:^|[^A-Za-z0-9_-])cf-turnstile(?:[^A-Za-z0-9_-]|$)",
                "case_insensitive": true
              },
              "weight": 30
            }
          }
        ]
      }
    },
    {
      "id": "google.recaptcha",
      "name": "Google reCAPTCHA",
      "description": "Detects documented reCAPTCHA standard or Enterprise client scripts; static widget and API-call markers are supporting evidence only.",
      "category": "captcha_challenge",
      "vendor": "Google",
      "product": "reCAPTCHA",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "match": {
        "any": [
          {
            "signal": {
              "id": "recaptcha-client-script",
              "group": "static_integration",
              "description": "Documented standard or Enterprise reCAPTCHA JavaScript API URL",
              "type": "script_url",
              "source": {
                "exact": "http_analyzer"
              },
              "value": {
                "regex": "^https://www\\.(?:google\\.com|recaptcha\\.net)/recaptcha/(?:api|enterprise)\\.js(?:\\?redacted)?$",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "recaptcha-html-marker",
              "group": "static_integration",
              "description": "Static g-recaptcha widget marker",
              "type": "page_content",
              "source": {
                "exact": "http_analyzer"
              },
              "value": {
                "regex": "(?:^|[^A-Za-z0-9_-])g-recaptcha(?:[^A-Za-z0-9_-]|$)",
                "case_insensitive": true
              },
              "weight": 30
            }
          },
          {
            "signal": {
              "id": "recaptcha-inline-call",
              "group": "static_integration",
              "description": "Static grecaptcha render or execute call",
              "type": "page_content",
              "source": {
                "exact": "http_analyzer"
              },
              "value": {
                "regex": "grecaptcha\\s*\\.\\s*(?:execute|render)\\s*\\(",
                "case_insensitive": true
              },
              "weight": 35
            }
          }
        ]
      }
    },
    {
      "id": "aws.cloudfront",
      "name": "Amazon CloudFront",
      "description": "Detects Amazon CloudFront edge infrastructure from x-amz-cf-id, x-amz-cf-pop, Server headers, CNAME routing, or TLS certificates.",
      "category": "cdn_reverse_proxy",
      "vendor": "AWS",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "match": {
        "any": [
          {
            "signal": {
              "id": "aws-cf-id-header",
              "group": "response_headers",
              "description": "CloudFront request ID header",
              "type": "response_header",
              "key": {
                "exact": "x-amz-cf-id",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-cf-pop-header",
              "group": "response_headers",
              "description": "CloudFront POP identifier header",
              "type": "response_header",
              "key": {
                "exact": "x-amz-cf-pop",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-cf-server-header",
              "group": "response_headers",
              "description": "CloudFront Server response header",
              "type": "response_header",
              "key": {
                "exact": "Server",
                "case_insensitive": true
              },
              "value": {
                "contains": "CloudFront",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-cf-cache-header",
              "group": "response_headers",
              "description": "CloudFront X-Cache response header",
              "type": "response_header",
              "key": {
                "exact": "x-cache",
                "case_insensitive": true
              },
              "value": {
                "contains": "cloudfront",
                "case_insensitive": true
              },
              "weight": 35
            }
          },
          {
            "signal": {
              "id": "aws-cf-cname",
              "group": "dns",
              "description": "CloudFront canonical edge CNAME",
              "type": "dns_record",
              "key": {
                "exact": "cname",
                "case_insensitive": true
              },
              "value": {
                "regex": "\\.cloudfront\\.net$",
                "case_insensitive": true
              },
              "weight": 30
            }
          },
          {
            "signal": {
              "id": "aws-cf-cert-issuer",
              "group": "tls",
              "description": "Amazon issued TLS certificate",
              "type": "tls_property",
              "key": {
                "exact": "certificate_issuer",
                "case_insensitive": true
              },
              "value": {
                "contains": "Amazon",
                "case_insensitive": true
              },
              "weight": 20
            }
          }
        ]
      }
    },
    {
      "id": "aws.waf",
      "name": "AWS WAF",
      "description": "Detects AWS WAF integration scripts, WAF action headers, error types, or standard block pages.",
      "category": "waf",
      "vendor": "AWS",
      "product": "AWS WAF",
      "minimum_evidence": 1,
      "minimum_score": 75,
      "match": {
        "any": [
          {
            "signal": {
              "id": "aws-waf-sdk-script",
              "group": "static_integration",
              "description": "AWS WAF JavaScript SDK integration script URL",
              "type": "script_url",
              "value": {
                "regex": "^https://[a-f0-9]+\\.(?:awswaf|waf\\.aws\\.amazon)\\.com/",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-waf-action-header",
              "group": "response_headers",
              "description": "AWS WAF action response header",
              "type": "response_header",
              "key": {
                "exact": "x-amzn-waf-action",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-waf-errortype-header",
              "group": "response_headers",
              "description": "AWS WAF error type response header",
              "type": "response_header",
              "key": {
                "exact": "x-amzn-errortype",
                "case_insensitive": true
              },
              "value": {
                "contains": "WAF",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-waf-block-page",
              "group": "static_integration",
              "description": "AWS WAF block page content",
              "type": "page_content",
              "value": {
                "regex": "(?:405 Method Not Allowed.*AWS WAF|<title>403 Forbidden</title>.*(?:CloudFront.*AWS WAF|Generated by cloudfront.*AWS WAF)|<H1>403 Forbidden</H1>.*AWS WAF)",
                "case_insensitive": true
              },
              "weight": 75
            }
          },
          {
            "signal": {
              "id": "aws-waf-token-cookie",
              "group": "cookies",
              "description": "AWS WAF token cookie",
              "type": "cookie",
              "key": {
                "exact": "aws-waf-token",
                "case_insensitive": true
              },
              "weight": 40
            }
          },
          {
            "signal": {
              "id": "aws-waf-marker",
              "group": "static_integration",
              "description": "AWS WAF token or element marker",
              "type": "page_content",
              "value": {
                "regex": "(?:aws-waf-|AwsWafIntegration)",
                "case_insensitive": true
              },
              "weight": 30
            }
          }
        ]
      }
    },
    {
